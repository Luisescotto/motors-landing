---
import { getAllSliders } from "../lib/wp";

const sliders = await getAllSliders();
---

<style>
  .slide {
    transition: all 0.7s ease-in-out;
  }
  .slide.active {
    opacity: 1;
    transform: translateX(0);
  }
  .slide:not(.active) {
    opacity: 0;
    transform: translateX(100%);
    pointer-events: none;
  }
</style>

<section class="bg-dark h-96 lg:h-full flex justify-center">
  <div class="relative w-full h-full group">
    <!-- Main slider -->
    <div class="relative h-full overflow-hidden">
      {
        sliders.map((slider) => (
          <div class="slide active absolute w-full h-full">
            <img
              src={slider}
              alt="Forest Path"
              class="w-full h-96 lg:h-full object-cover pointer-events-none"
            />
          </div>
        ))
      };
    </div>

    <!-- Navigation Arrows -->
    <button
      onclick="previousSlide()"
      class="absolute left-4 top-1/2 -translate-y-1/2 bg-dark/30 text-white w-11 h-11 rounded-full backdrop-blur-sm lg:opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-dark/50 p-2 cursor-pointer"
    >
      <img src="/images/left.svg" alt="" />
    </button>
    <button
      onclick="nextSlide()"
      class="absolute right-4 top-1/2 -translate-y-1/2 bg-dark/30 text-white w-11 h-11 rounded-full backdrop-blur-sm lg:opacity-0 group-hover:opacity-100 transition-opacity duration-300 hover:bg-dark/50 p-2 cursor-pointer"
    >
      <img src="/images/right.svg" alt="" />
    </button>

    <!-- Dots Navigation -->
    <div
      id="slider-controls"
      class="absolute bottom-4 left-1/2 transform -translate-y-1/2 flex space-x-2"
      is:client
    >
      {
        sliders.map((e, index) => (
          <button
            class="w-4 h-2 rounded-full bg-white transition-all duration-300 cursor-pointer"
            onclick={`goToSlide(${index})`}
          />
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  const slides = document.querySelectorAll(".slide");
  const dots = document.querySelectorAll(".absolute.bottom-4 button");
  let currentSlide = 0;
  let slideInterval;

  goToSlide(0);

  function updateSlides() {
    slides.forEach((slide, index) => {
      if (index == currentSlide) {
        slide.classList.add("active");
      } else {
        slide.classList.remove("active");
      }
    });

    dots.forEach((dot, index) => {
      if (index == currentSlide) {
        dot.classList.add("w-4", "bg-white");
        dot.classList.remove("w-2", "bg-white/50");
      } else {
        dot.classList.remove("w-4", "bg-white");
        dot.classList.add("w-2", "bg-white/50");
      }
    });
  }
  function nextSlide() {
    currentSlide = (currentSlide + 1) % slides.length;
    updateSlides();
    resetinterval();
  }
  function previousSlide() {
    currentSlide = (currentSlide - 1 + slides.length) % slides.length;
    updateSlides();
    resetinterval();
  }
  function goToSlide(index) {
    currentSlide = index;
    updateSlides();
    resetinterval();
  }
  function resetinterval() {
    clearInterval(slideInterval);
    startInterval();
  }
  function startInterval() {
    slideInterval = setInterval(nextSlide, 5000);
  }
</script>
