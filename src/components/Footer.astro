    <!-- Enlaces rápidos -->
    <div class="w-full">
      <ul class="space-y-2 text-lg md:flex justify-center gap-6 text-dark">
        <li>
          <a
            href="/"
            class="text-dark hover:text-main transition-colors duration-200 text-lg font-medium"
            >Inicio</a
          >
        </li>

        <li>
          <a
            href="/#catalogo"
            class="text-dark hover:text-main transition-colors duration-200 text-lg font-medium"
            >Catálogo</a
          >
        </li>
        <li>
          <a
            href="/#financiamiento"
            class="text-dark hover:text-main transition-colors duration-200 text-lg font-medium"
            >Financiamiento</a
          >
        </li>
