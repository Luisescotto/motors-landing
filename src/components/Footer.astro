---
import Logo from "./Logo.astro";
import Socials from "./Socials.astro";

import { getAllSocials } from "../lib/wp";
const socials = await getAllSocials();

const { email_principal, email_secundario } = Astro.props;
---

<footer class="bg-white text-dark py-6 flex justify-center">
  <div
    class="max-w-7xl w-full flex flex-col gap-4 justify-center text-center items-center"
  >
    <div class="bg-main/10 p-3 rounded-full">
      <Logo />
    </div>

    <div class="w-full">
      <ul class="space-y-2 text-lg md:flex justify-center gap-6 text-dark">
        <li>
          <a
            href="/"
            class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
            >Inicio</a
          >
        </li>

        <li>
          <a
            href="/#catalogo"
            class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
            >Catálogo</a
          >
        </li>
        <li>
          <a
            href="/#financiamiento"
            class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
            >Financiamiento</a
          >
        </li>
        <li>
          <a
            href="/#contacto"
            class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
            >Contacto</a
          >
        </li>
      </ul>
    </div>

    <div class="w-full">
      <div class="flex flex-col gap-2 py-2 items-center">
        <a
          href=`mailto:${email_principal}`
          class="hover:text-acent transition-colors duration-200"
          >{email_principal}</a
        >
        <a
          href=`mailto:${email_secundario}`
          class="hover:text-acent transition-colors duration-200"
          >{email_secundario}</a
        >
      </div>

      <ul class="space-y-2 text-sm flex justify-center gap-6">
        {
          socials.map((social) => (
            <Socials
              titulo={social.titulo}
              link={social.link}
              icono={social.icono}
            />
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<div
  class="bg-dark-secondary border-t border-gray-50/20 py-6 text-center text-xs text-gray-500"
>
  Copyright 2025&copy; Luis Manuel Abreu Motors.
</div>
