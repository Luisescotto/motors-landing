    <!-- Redes sociales -->
    <div class="w-full">
      <ul class="space-y-2 text-sm flex justify-center gap-6">
        {
          socials.map((social) => (
            <Socials
              titulo={social.titulo}
              link={social.link}
              icono={social.icono}
            />
          ))
        }
      </ul>
    </div>
