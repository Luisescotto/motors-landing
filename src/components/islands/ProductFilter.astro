---
// ProductFilter.astro
const { products } = Astro.props;
import ProductCard from "../productCard.astro";
---

<script type="module">
  import ReactFilter from "./ProductFilter.jsx";
  const root = document.querySelector("#react-filter");
  const rawProducts = JSON.parse(root.dataset.products);
  ReactFilter({ products: rawProducts, target: root });
</script>

<div id="react-filter" data-products={JSON.stringify(products)}></div>

<template id="card-template">
  {products.map((product) => <ProductCard {...product} client:only="astro" />)}
</template>
