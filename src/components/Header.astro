---
import { Icon } from "astro-icon/components";

import Logo from "./Logo.astro";
import Socials from "./Socials.astro";

import { getAllSocials } from "../lib/wp";
const socials = await getAllSocials();
---

<nav class="text-white fixed w-full top-0 z-30 bg-white shadow-md">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <Logo />

      <div class="py-2 text-center flex justify-center items-center">
        <!-- contenedor de Pagefind -->
        <div id="search" class="pagefind-container"></div>
      </div>

      <script>
        window.addEventListener("DOMContentLoaded", () => {
          // @ts-ignore
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            resetStyles: false,
          });
        });
      </script>

      <!-- Menú de navegación (desktop) -->
      <div class="hidden md:flex space-x-8 justify-center items-center">
        <a
          href="/#"
          class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
          >Inicio</a
        >
        <a
          href="/#financiamiento"
          class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
          >Financiamiento</a
        >
        <a
          href="/#catalogo"
          class="text-dark hover:text-acent transition-colors duration-200 text-lg font-medium"
          >Catálogo</a
        >
        <a
          href="/#contacto"
          class="text-white hover:scale-110 transition-transform duration-200 text-lg font-medium bg-acent rounded-4xl px-4 py-2 flex items-center"
          >Contacto <Icon name="arrowRight" size={22} class="font-bold" />
        </a>
      </div>

      <!-- Botón hamburguesa (móvil) -->
      <button
        id="open-menu"
        type="button"
        class="text-dark hover:text-acent focus:outline-none focus:text-white md:hidden cursor-pointer"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Overlay oscuro -->
<div
  id="overlay"
  class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden transition-opacity duration-300"
>
</div>

<!-- Menú móvil -->
<div
  id="mobile-menu"
  class="fixed top-0 right-0 h-full w-64 bg-white/80 backdrop-blur-lg z-50 transform translate-x-full transition-transform duration-300 md:hidden shadow-lg"
>
  <div class="p-4 flex flex-col">
    <button
      id="close-menu"
      class="self-end text-dark hover:text-acent text-xl cursor-pointer"
    >
      ✕
    </button>
    <Logo class="link" />
    <a
      href="/#"
      class="py-2 text-dark hover:text-acent text-3xl font-medium link"
      >Inicio</a
    >
    <a
      href="/#financiamiento"
      class="py-2 text-dark hover:text-acent text-3xl font-medium link"
      >Financiamiento</a
    >
    <a
      href="/#catalogo"
      class="py-2 text-dark hover:text-acent text-3xl font-medium link"
      >Catálogo</a
    >
    <a
      href="/#contacto"
      class="py-2 text-dark hover:text-acent text-3xl font-medium link"
      >Contacto</a
    >
  </div>

  <div class="w-full">
    <ul class="space-y-2 text-sm flex gap-6 px-4 flex-wrap">
      {
        socials.map((social) => (
          <Socials
            titulo={social.titulo}
            link={social.link}
            icono={social.icono}
          />
        ))
      }
    </ul>
  </div>
</div>

<script is:inline>
  const openBtn = document.getElementById("open-menu");
  const closeBtn = document.getElementById("close-menu");
  const menu = document.getElementById("mobile-menu");
  const overlay = document.getElementById("overlay");
  const links = document.querySelectorAll(".link");

  openBtn?.addEventListener("click", () => {
    menu.classList.remove("translate-x-full");
    overlay.classList.remove("hidden");
  });

  closeBtn?.addEventListener("click", () => {
    menu.classList.add("translate-x-full");
    overlay.classList.add("hidden");
  });

  overlay?.addEventListener("click", () => {
    menu.classList.add("translate-x-full");
    overlay.classList.add("hidden");
  });

  links.forEach((element) => {
    element.addEventListener("click", () => {
      menu.classList.add("translate-x-full");
      overlay.classList.add("hidden");
    });
  });
</script>
