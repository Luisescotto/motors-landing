---
const { slug, titulo, ano, precio, precioOferta, imagen, marca, modelo } =
  Astro.props;

function formatearPrecio(valor: number) {
  return new Intl.NumberFormat("es-DO", {
    style: "currency",
    currency: "DOP",
    minimumFractionDigits: 2,
  }).format(valor);
}
---

<li class="group cursor-pointer h-auto shadow-xl" data-marca={marca}>
  <a href={`/producto/${slug}`}>
    <div class="flex flex-col items-center rounded-xl h-full relative">
      {
        precioOferta && (
          <div class="absolute top-2 right-0 bg-white text-acent text-xs font-bold px-2 py-1.5 rounded-l-2xl  shadow-md">
            Oferta
          </div>
        )
      }
      <header
        class="flex flex-col justify-center items-center text-center w-full px-2 bg-main border-b border-gray-200 flex-grow"
      >
        <h3
          class="pt-6 text-lg font-semibold text-white leading-tight capitalize"
        >
          {`${titulo} (${ano})`}
        </h3>
        {
          precioOferta ? (
            <div class="mb-2 space-x-2">
              <span class="text-white text-sm line-through opacity-70">
                {formatearPrecio(precio)}
              </span>
              <span class="text-white font-bold text-lg">
                {formatearPrecio(precioOferta)}
              </span>
            </div>
          ) : (
            <span class="text-white font-bold text-lg mb-2">
              {formatearPrecio(precio)}
            </span>
          )
        }
      </header>

      <div class="bg-white w-full flex justify-center px-4">
        <img
          src={imagen}
          alt={titulo}
          class="w-60 h-40 object-contain mb-4 group-hover:scale-130 transition-transform duration-500"
        />
      </div>

      <footer
        class="flex w-full justify-center text-center bg-white py-4 px-1 border-t border-gray-200"
      >
        <div class="w-full text-sm text-gray-500 border-r border-gray-300 py-2">
          <p class="">Marca:</p>
          <span class="font-bold text-xs text-dark capitalize">{marca}</span>
        </div>
        <div class="w-full text-sm text-gray-500 py-2">
          <p class="">Modelo:</p>
          <span class="font-bold text-xs text-dark capitalize">{modelo}</span>
        </div>
      </footer>
    </div>
  </a>
</li>
