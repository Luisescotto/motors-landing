---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import "../styles/global.css";
import "@fontsource-variable/roboto";

import { getBussinesInfo } from "../lib/wp";

const {
  logo,
  nombre,
  keywords,
  direccion_web,
  email_principal,
  email_secundariio,
} = await getBussinesInfo();

const { titulo, imagen, descripcion, categoria } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo ? `${titulo} - ${nombre}` : `Catálogo - ${nombre}`}</title>
    <!-- ESTA LÍNEA ES LA QUE FALTABA -->
    <meta name="title" content={titulo ? `${titulo} - ${nombre}` : nombre} />
    <meta
      name="description"
      content={descripcion
        ? `${descripcion} Ven por la tuya a ${nombre}`
        : `Catalogo de motores y pasolas - ${nombre}`}
    />
    <meta
      name="keywords"
      content={titulo ? `${keywords}, ${titulo}, ${categoria} ` : `${keywords}`}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={`${titulo} - ${nombre}`} />
    <meta
      property="og:description"
      content=`${descripcion} Ven a comprar tu ${titulo} a ${nombre}`
    />
    <meta property="og:image" content={imagen} />
    <meta property="og:url" content={direccion_web} />
    <meta property="og:type" content="product" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${titulo} - ${nombre}`} />
    <meta
      name="twitter:description"
      content=`${descripcion} Ven por la tuya a ${nombre}`
    />
    <meta name="twitter:image" content={imagen} />

    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
    <link
      rel="apple-touch-icon"
      sizes="114x114"
      href="/apple-icon-114x114.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="120x120"
      href="/apple-icon-120x120.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="144x144"
      href="/apple-icon-144x144.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="152x152"
      href="/apple-icon-152x152.png"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-icon-180x180.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-icon-192x192.png"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-ui.js" is:inline></script>
  </head>
  <body>
    <Header />

    <slot />

    <Footer
      email_principal={email_principal}
      email_secundario={email_secundariio}
    />
  </body>
</html>
<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
    font-family: "Roboto Variable", sans-serif;
  }
</style>
