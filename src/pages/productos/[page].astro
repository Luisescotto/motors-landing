---
import Layout from "@/layouts/ProductoLayout.astro";
import ProductCard from "@/components/productCard.astro";
import { getAllProducts } from "@/lib/wp";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const products = await getAllProducts();
  return paginate(products, { pageSize: 12 }); // 👈 aquí controlas cuántos por página
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const marcas = [...new Set(page.data.map((p) => p.marca).filter(Boolean))];
---

<Layout>
  <section class="bg-white py-12 px-4 w-full">
    <main class="w-full mx-auto max-w-7xl text-center px-4">
      <h1 class="text-dark text-3xl font-bold mt-8">
        Motocicletas disponibles
      </h1>
      <p class="text-dark/80 text-lg leading-relaxed mb-4">
        Descubre nuestra amplia selección de modelos disponibles
      </p>

      <!-- Filtros -->
      <div class="py-8">
        <label for="marca">Filtrar por marca:</label>
        <select id="marca" name="marca">
          <option value="">Todas</option>
          {marcas.map((marca) => <option value={marca}>{marca}</option>)}
        </select>
      </div>

      <!-- Productos -->
      <ul
        id="productos"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 justify-center"
      >
        {
          page.data.map((product) => (
            <ProductCard
              titulo={product.titulo}
              slug={product.slug}
              ano={product.ano}
              precio={product.precio}
              precioOferta={product.precioOferta}
              marca={product.marca}
              modelo={product.modelo}
              imagen={product.imagen}
            />
          ))
        }
      </ul>

      <!-- Navegación de paginación -->
      <nav class="flex justify-center items-center gap-4 mt-8">
        {
          page.url.prev && (
            <a
              href={page.url.prev}
              class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300 text-dark"
            >
              ← Anterior
            </a>
          )
        }
        <span>Página {page.currentPage} de {page.lastPage}</span>
        {
          page.url.next && (
            <a
              href={page.url.next}
              class="px-4 py-2 rounded bg-gray-200 hover:bg-gray-300 text-dark"
            >
              Siguiente →
            </a>
          )
        }
      </nav>
    </main>
  </section>
</Layout>

<script is:inline>
  const select = document.getElementById("marca");
  select.addEventListener("change", (e) => {
    const value = e.target.value;
    if (!value) {
      window.location.href = "/productos/1"; // todas, página 1
    } else {
      window.location.href = `/productos/marca/${value}/1`; // página 1 de esa marca
    }
  });
</script>

