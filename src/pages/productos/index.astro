---
import Layout from "@/layouts/ProductoLayout.astro";
import ProductCard from "@/components/productCard.astro";

import { getLatestProducts } from "../../lib/wp";

const products = await getLatestProducts({ perPage: 100 });
const marcas = [...new Set(products.map((p) => p.marca).filter(Boolean))];
---

<!-- Filtros -->
<Layout>
  <!-- Lista de productos -->
  <!-- <div id="productos">
    {products.map((product) => <ProductCard {...product} />)}
  </div> -->

  <section class="bg-white py-12 px-4 w-full">
    <main class="w-full mx-auto max-w-7xl text-center px-4">
      <h1 class="text-dark text-3xl font-bold my-6">
        Motocicletas disponibles
      </h1>
      <p class="text-dark/80 text-lg leading-relaxed mb-4">
        Descubre nuestra amplia selección de modelos disponibles
      </p>

      <!-- Filtros -->
      <div class="py-8">
        <label for="marca">Filtrar por marca:</label>
        <select id="marca" name="marca">
          <option value="">Todas</option>
          {marcas.map((marca) => <option value={marca}>{marca}</option>)}
        </select>
      </div>
      <ul
        id="productos"
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 justify-center"
      >
        {
          products.map((product) => (
            <ProductCard
              titulo={product.titulo}
              slug={product.slug}
              ano={product.ano}
              precio={product.precio}
              precioOferta={product.precioOferta}
              marca={product.marca}
              modelo={product.modelo}
              imagen={product.imagen}
            />
          ))
        }
      </ul>
    </main>
  </section>
</Layout>

<!-- Script de filtrado -->
<script is:inline>
  const select = document.getElementById("marca");
  const cards = [...document.querySelectorAll("#productos > *")];

  select.addEventListener("change", (e) => {
    const value = e.target.value;
    cards.forEach((card) => {
      const marca = card.getAttribute("data-marca");
      card.style.display = !value || marca === value ? "block" : "none";
    });
  });
</script>
