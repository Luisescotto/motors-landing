---
import { Astro } from "astro";
import { Image } from "astro:assets";
import pageNotFoundImage from "../assets/images/pageNotFound.png";

import "../styles/global.css";
Astro.response.status = 404;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página no encontrada | MotoShop</title>
    <meta name="robots" content="noindex" />
  </head>
  <body
    class="min-h-screen flex items-center justify-center bg-black text-white bg-cover bg-center"
  >
    <div class="bg-black/70 w-full h-full absolute top-0 left-0">
      <Image
        class="h-full w-full filter pointer-events-none object-cover relative"
        width="1920"
        height="1080"
        src={pageNotFoundImage}
        alt="Logo tienda de motos"
        quality="mid"
      />
    </div>

    <main class="relative z-10 text-center flex w-full">
      <!-- <div class="w-full h-full"></div> -->
      <div
        class="w-full min-h-screen bg-dark/70 flex flex-col justify-center items-center text-center"
      >
        <h1 class="text-8xl font-extrabold mb-4">404</h1>
        <p class="text-2xl mb-6">Ups... Ruta equivocada.</p>
        <p class="text-md mb-8">Regresa al camino correcto.</p>

        <a
          href="/"
          class="inline-block bg-acent hover:bg-acent/80 text-white font-semibold px-6 py-3 rounded-lg transition duration-300 w-fit"
        >
          Volver al inicio
        </a>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    /* background-image: url({pageNotFoundImage}); */
  }

  .filter {
    filter: brightness(100%) saturate(45%) invert(15%) sepia(20%) saturate(800%)
      hue-rotate(350deg) brightness(100%) contrast(72%);
  }
</style>
