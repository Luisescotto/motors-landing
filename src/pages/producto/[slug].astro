---
// src/pages/productos/[slug].astro
import ProductoLayout from "@/layouts/ProductoLayout.astro";
import ProductCard from "@/components/productCard.astro";
import FinancingForm from "@/components/islands/FinancingForm";

import { Icon } from "astro-icon/components";
import {
  getAllProductsSlugs,
  getProductInfo,
  getRelatedProducts,
} from "../../lib/wp";

export async function getStaticPaths() {
  const slugs = await getAllProductsSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const {
  titulo,
  categoria,
  modelo,
  marca,
  precio,
  precioOferta,
  imagen,
  galeria = [],
  especificaciones = [],
} = await getProductInfo(Astro.params.slug);

const { slug } = Astro.params;

const numericPrice = Number(precio);
const numericOferta = Number(precioOferta);

const formattedPrice = !isNaN(numericPrice)
  ? new Intl.NumberFormat("es-DO", {
      style: "currency",
      currency: "DOP",
    }).format(numericPrice)
  : "Precio no disponible";

const formattedOferta = !isNaN(numericOferta)
  ? new Intl.NumberFormat("es-DO", {
      style: "currency",
      currency: "DOP",
    }).format(numericOferta)
  : "Precio no disponible";

const relateds = await getRelatedProducts(categoria, slug);
---

<ProductoLayout titulo={titulo} imagen={imagen}>
  <main class="bg-white text-dark pt-12">
    <section
      class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-2 gap-2"
    >
      <div class="flex flex-col md:flex-row gap-4 w-full">
        <img
          id="mainImage"
          src={imagen}
          alt={titulo}
          class="rounded-xl shadow-lg w-full lg:w-96 h-96 object-contain"
        />
        <div class="flex md:flex-col flex-wrap gap-3 justify-center">
          {
            galeria.map((img, i) => (
              <img
                src={img}
                alt={`Galería ${i}`}
                data-image-src={img}
                class="thumbnail w-24 h-24 object-contain rounded-md border-2 border-transparent hover:border-main cursor-pointer"
              />
            ))
          }
        </div>
      </div>

      <div class="flex flex-col justify-between py-4">
        <span
          class="rounded-full text-sm font-semibold py-1 px-2 bg-main text-white w-fit"
          >2025</span
        >
        <div>
          <h1 class="text-4xl text-main font-bold capitalize">{titulo}</h1>
        </div>

        <div class="space-y-2">
          {
            precioOferta ? (
              <>
                <p class="line-through text-gray-500">{formattedPrice}</p>
                <p class="text-3xl font-bold text-main">{formattedOferta}</p>
                <span class="text-sm text-main bg-main/10 px-2 py-1 rounded-full">
                  Ahorra {Math.round(((precio - precioOferta) / precio) * 100)}%
                </span>
              </>
            ) : (
              <p class="text-3xl font-bold text-dark">{formattedPrice}</p>
            )
          }
        </div>

        <div class="flex gap-4">
          <div class="flex items-center gap-2 text-main font-semibold">
            <Icon name="credit-card" size="20" /> Financiamiento disponible
          </div>
          <div class="flex items-center gap-2 text-main font-semibold">
            <Icon name="safe" size="20" /> Garantía de 2 años
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a
            href="#"
            class="bg-green-700 hover:bg-green-800 text-white py-3 px-4 rounded-lg flex items-center justify-center gap-2"
          >
            <Icon name="whatsapp" size="20" /> Contactar por WhatsApp
          </a>
          <a
            href="#"
            class="bg-main/10 hover:bg-main/30 text-dark py-3 px-4 rounded-lg flex items-center justify-center gap-2"
          >
            <Icon name="phone" size="20" /> Llamar
          </a>
          <button
            id="shareBtn"
            class="bg-main/10 hover:bg-main/30 text-dark py-3 px-4 rounded-lg flex items-center justify-center gap-2 col-span-full cursor-pointer"
          >
            <Icon name="share" size="20" /> Compartir
            <span id="tooltip" class="tooltip">¡Enlace copiado!</span>
          </button>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 pb-12">
      <h2 class="text-2xl font-bold text-center mb-6">Especificaciones</h2>
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
      >
        {
          especificaciones.map(([key, value]) => (
            <div class="bg-[#2d2d2d] text-white rounded-xl p-4 shadow">
              <p class="text-sm text-acent uppercase">{key}</p>
              <p class="text-base font-semibold capitalize">{value}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bg-main/10 py-12">
      <div class="max-w-4xl mx-auto px-4">
        {
          precioOferta ? (
            <FinancingForm client:load price={precioOferta} />
          ) : (
            <FinancingForm client:load price={precio} />
          )
        }
      </div>
    </section>
  </main>

  <section
    class="max-w-7xl flex flex-col items-center justify-center w-full mx-auto py-4"
  >
    <h3 class="text-2xl font-bold text-center mb-6">Productos relacionados</h3>
    <ul class="flex flex-col md:flex-row gap-4 justify-center">
      {
        relateds.map((related) => (
          <ProductCard
            titulo={related.titulo}
            slug={related.slug}
            precio={related.precio}
            precioOferta={related.precioOferta}
            marca={related.marca}
            modelo={related.modelo}
            imagen={related.imagen}
          />
        ))
      }
    </ul>
  </section>
</ProductoLayout>

<style>
  .tooltip {
    position: absolute;
    background-color: #000;
    color: #fff;
    padding: 6px 10px;
    font-size: 12px;
    border-radius: 6px;
    top: 110%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .tooltip.show {
    opacity: 1;
  }
</style>

<script is:inline>
  const button = document.getElementById("shareBtn");
  const tooltip = document.getElementById("tooltip");

  button?.addEventListener("click", async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
        return;
      } catch (_) {}
    }

    try {
      await navigator.clipboard.writeText(window.location.href);
      tooltip.classList.add("show");
      setTimeout(() => tooltip.classList.remove("show"), 2000);
    } catch (err) {
      console.error("Error al copiar", err);
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    const mainImage = document.getElementById("mainImage");
    const thumbnails = document.querySelectorAll(".thumbnail");

    thumbnails.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const newSrc = thumb.dataset.imageSrc;
        if (mainImage && newSrc) mainImage.src = newSrc;

        thumbnails.forEach((t) => t.classList.remove("thumbnail-active"));
        thumb.classList.add("thumbnail-active");
      });
    });

    if (thumbnails.length > 0) thumbnails[0].classList.add("thumbnail-active");
  });
</script>

<style>
  .thumbnail-active {
    border-color: var(--color-main, #0ea5e9);
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.4);
  }
</style>
