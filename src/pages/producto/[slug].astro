---
import { Image } from "astro:assets";

import ProductoLayout from "@/layouts/ProductoLayout.astro";
import ProductCard from "@/components/productCard.astro";
import FinancingForm from "@/components/islands/FinancingForm";

import { Icon } from "astro-icon/components";
import {
  getAllProductsSlugs,
  getProductInfo,
  getRelatedProducts,
} from "../../lib/wp";
import { formatPrice } from "@/lib/utils";

export async function getStaticPaths() {
  const slugs = await getAllProductsSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const {
  titulo,
  descripcion,
  ano,
  categoria,
  modelo,
  marca,
  precio,
  precioOferta,
  inicial,
  imagen,
  galeria = [],
  especificaciones = [],
} = await getProductInfo(Astro.params.slug);

const { slug } = Astro.params;

const numericPrice = Number(precio);
const numericOferta = Number(precioOferta);

const formattedPrice = formatPrice(precio);
const formattedOferta = formatPrice(precioOferta);
const formattedInicial = formatPrice(inicial);

const relateds = await getRelatedProducts(categoria, slug);

const message = `Hola, me interesa el modelo ${titulo}(${ano}). ¿Está disponible?`;
const phoneNumber = "18092420183";

const encodedMessage = encodeURIComponent(message);
const whatsappURL = `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
---

<ProductoLayout
  titulo={titulo}
  imagen={imagen}
  descripcion={descripcion}
  categoria={categoria}
>
  <main class="bg-white text-dark pt-12 text-left" data-pagefind-body>
    <div class="pt-8 max-w-7xl mx-auto px-4 flex flex-col items-center">
      <div class="text-center">
        <h1
          class="text-2xl md:text-4xl text-main font-bold capitalize"
          data-pagefind-index-attrs="title,year"
        >
          {`${titulo} (${ano})`}
        </h1>
      </div>
    </div>
    <section
      class="max-w-7xl mx-auto px-4 pb-6 grid grid-cols-1 lg:grid-cols-2 gap-2"
    >
      <div
        class="flex flex-col md:flex-row gap-4 w-full justify-center items-center"
      >
        {
          imagen && (
            <img
              id="mainImage"
              src={imagen}
              alt={titulo}
              class="rounded-xl shadow-lg w-full lg:w-96 h-96 object-contain"
            />
          )
        }

        {
          galeria?.filter((img) => img && img.trim() !== "").length > 0 && (
            <div class="flex md:flex-col flex-wrap gap-3 justify-center md:items-center">
              {galeria
                .filter((img) => img && img.trim() !== "")
                .map((img, i) => (
                  <img
                    src={img}
                    alt={`Galería ${i}`}
                    data-image-src={img}
                    class="thumbnail w-24 h-24 object-contain rounded-md border-2 border-transparent hover:border-main cursor-pointer"
                  />
                ))}
            </div>
          )
        }
      </div>

      <div class="py-4">
        <p
          class="max-w-7xl mx-auto pb-6 text-left text-sm text-main/90 font-medium leading-6"
          data-pagefind-ignore
        >
          {descripcion}
        </p>

        <div class="space-y-2">
          {
            precioOferta ? (
              <>
                <p class="line-through text-gray-500" data-pagefind-ignore>
                  {formattedPrice}
                </p>
                <p
                  class="text-3xl font-bold text-main"
                  data-pagefind-index-attrs="offer"
                >
                  {formattedOferta}
                </p>
                <span
                  class="text-sm text-main bg-main/10 px-2 py-1 rounded-full"
                  data-pagefind-ignore
                >
                  Ahorra {Math.round(((precio - precioOferta) / precio) * 100)}%
                </span>
              </>
            ) : (
              <p class="text-3xl font-bold text-dark">{formattedPrice}</p>
            )
          }
        </div>
        <div>
          <small>Inicial: {formattedInicial}</small>
        </div>

        <div
          class="flex flex-col md:flex-row gap-4 py-4"
          data-pagefind-ignore="all"
        >
          <div class="flex items-center gap-2 text-main font-semibold">
            <Icon name="credit-card" size="20" /> Financiamiento disponible
          </div>
          <div class="flex items-center gap-2 text-main font-semibold">
            <Icon name="safe" size="20" /> Garantía de 2 años
          </div>
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-4"
          data-pagefind-ignore="all"
        >
          <a
            href={whatsappURL}
            target="_blank"
            class="bg-green-700 hover:bg-green-800 text-white py-3 px-4 rounded-lg flex items-center justify-center gap-2"
          >
            <Icon name="whatsapp" size="20" /> Me interesa
          </a>
          <a
            href="/#contacto"
            class="bg-main/10 hover:bg-main/30 text-dark py-3 px-4 rounded-lg flex items-center justify-center gap-2"
          >
            <Icon name="address" size="20" /> Buscar sucursal
          </a>
          <button
            id="shareBtn"
            class="bg-main/10 hover:bg-main/30 text-dark py-3 px-4 rounded-lg flex items-center justify-center gap-2 col-span-full cursor-pointer"
          >
            <Icon name="share" size="20" /> Compartir
            <span id="tooltip" class="tooltip">¡Enlace copiado!</span>
          </button>
        </div>

        {
          Array.isArray(especificaciones) &&
            especificaciones.filter(
              ([_, value]) => value && value.trim() !== ""
            ).length > 0 && (
              <div
                class="max-w-7xl mx-auto px-4 py-6"
                data-pagefind-ignore="all"
              >
                <h2 class="text-2xl font-bold text-center mb-6">
                  Especificaciones
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                  {especificaciones
                    .filter(([_, value]) => value && value.trim() !== "")
                    .map(([key, value]) => (
                      <div class="bg-main/10 hover:bg-main/30 rounded-lg p-4 shadow">
                        <p class="text-sm text-dark/80 capitalize font-medium">
                          {key}
                        </p>
                        <p class="text-base text-dark font-semibold capitalize">
                          {value}
                        </p>
                      </div>
                    ))}
                </div>
              </div>
            )
        }
      </div>
    </section>

    <section class="bg-main/10 py-12" data-pagefind-ignore="all">
      <div class="max-w-4xl mx-auto px-4 text-center">
        {
          precioOferta ? (
            <FinancingForm client:load price={precioOferta} inicial={inicial} />
          ) : (
            <FinancingForm client:load price={precio} inicial={inicial} />
          )
        }

        <small class="text-sm text-dark text-center mt-4">
          ¿Listo para dar el siguiente paso? Solicite más información
          contactándonos.
        </small>
      </div>
    </section>
  </main>

  <section class="max-w-7xl mx-auto py-6 px-4" data-pagefind-ignore="all">
    <h3 class="text-2xl font-bold text-center mb-6">
      También te pueden interesar
    </h3>
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 justify-center"
    >
      {
        relateds.map((related) => (
          <ProductCard
            titulo={related.titulo}
            slug={related.slug}
            ano={related.ano}
            precio={related.precio}
            precioOferta={related.precioOferta}
            marca={related.marca}
            modelo={related.modelo}
            imagen={related.imagen}
          />
        ))
      }
    </ul>
  </section>
</ProductoLayout>

<style>
  .tooltip {
    position: absolute;
    background-color: #000;
    color: #fff;
    padding: 6px 10px;
    font-size: 12px;
    border-radius: 6px;
    top: 110%;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .tooltip.show {
    opacity: 1;
  }
</style>

<script is:inline>
  const button = document.getElementById("shareBtn");
  const tooltip = document.getElementById("tooltip");

  button?.addEventListener("click", async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
        return;
      } catch (_) {}
    }

    try {
      await navigator.clipboard.writeText(window.location.href);
      tooltip.classList.add("show");
      setTimeout(() => tooltip.classList.remove("show"), 2000);
    } catch (err) {
      console.error("Error al copiar", err);
    }
  });

  document.addEventListener("DOMContentLoaded", () => {
    const mainImage = document.getElementById("mainImage");
    const thumbnails = document.querySelectorAll(".thumbnail");

    thumbnails.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const newSrc = thumb.dataset.imageSrc;
        if (mainImage && newSrc) mainImage.src = newSrc;

        thumbnails.forEach((t) => t.classList.remove("thumbnail-active"));
        thumb.classList.add("thumbnail-active");
      });
    });

    if (thumbnails.length > 0) thumbnails[0].classList.add("thumbnail-active");
  });
</script>

<style>
  .thumbnail-active {
    border-color: var(--color-main, #0ea5e9);
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.4);
  }
</style>
